# Copy values into your hosting platform's secret/configuration settings.
# Never commit real credentials to source control. Provider secrets live on the backend only.
APP_ENV=development
BIND_HOST=127.0.0.1
BIND_PORT=8787
# Long random value used by the Android client to authenticate to this backend.
SPIDER_API_TOKEN=replace-with-a-random-client-token-of-24-plus-characters
# Explicit browser/WebView origins only; add the exact origin of any hosted frontend. Never use *.
SPIDER_CORS_ORIGINS=https://appassets.androidplatform.net
PROVIDER_TIMEOUT_SECONDS=18
# Per authenticated provider route, sliding 60-second window; 1–600 (default 20).
SPIDER_PROVIDER_RATE_LIMIT_PER_MINUTE=20

# Preferred for this project: Yandex AI Studio OpenAI-compatible API.
# Set PROVIDER_KIND=yandex_ai_studio and supply a service-account API key authorized for Foundation Models.
PROVIDER_KIND=yandex_ai_studio
YANDEX_API_KEY=replace-with-yandex-cloud-service-account-api-key
YANDEX_FOLDER_ID=replace-with-yandex-cloud-folder-id
YANDEX_MODEL=yandexgpt-5.1
# Optional. Cloud semantic search is separately opt-in in the app. Use a model URI such as
# emb://<folder-id>/text-embeddings/latest only if enabled for the selected Yandex account.
YANDEX_EMBEDDING_MODEL=

# Alternative: generic OpenAI-compatible provider. Use PROVIDER_KIND=openai_compatible instead.
PROVIDER_API_KEY=replace-with-provider-secret
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_MODEL=replace-with-a-model-supported-by-your-account
PROVIDER_EMBEDDING_MODEL=

